# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cookpro?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cookpro?retryWrites=true&w=majority

# Database Name (default: cookpro)
MONGODB_DB=cookpro

# Server Port (optional, default 3000)
PORT=3000
